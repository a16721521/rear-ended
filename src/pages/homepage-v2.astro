---
import BaseLayout from '../layouts/BaseLayout.astro';

const practiceAreas = [
  ['Rear-end collisions', '/rear-end-collision-lawyer-los-angeles.html'],
  ['Car accidents', '/car-accident-lawyer/'],
  ['Truck accidents', '/truck-accident-lawyer/'],
  ['Motorcycle accidents', '/motorcycle-accident-lawyer/'],
  ['Rideshare accidents', '/uber-lyft-accident-lawyer/'],
  ['Wrongful death', '/wrongful-death-lawyer/'],
];
---

<BaseLayout
  title="Homepage concept — Rear Ended"
  description="A restrained, modern homepage concept for Rear Ended."
  noindex={true}
>
  <div class="page">
    <header class="header" id="top">
      <a class="logo" href="/" aria-label="Rear Ended home">rear ended</a>
      <nav aria-label="Primary navigation">
        <a href="#approach">Our approach</a>
        <a href="#cases">Cases</a>
        <a href="#questions">Questions</a>
      </nav>
      <div class="header-contact">
        <a class="phone" href="tel:+12132865834">(213) 286-5834</a>
        <a class="small-button" href="/get-started/">Free case review</a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-copy">
          <p class="kicker">California collision attorneys</p>
          <h1>Rear-ended?<br />Get clear legal help.</h1>
          <p class="lede">Before the insurance company decides what happens next, understand your options. We handle the claim so you can focus on getting better.</p>
          <div class="hero-actions">
            <a class="button" href="/get-started/">Start a free case review <span>→</span></a>
            <a class="call" href="tel:+12132865834">Or call (213) 286-5834</a>
          </div>
          <p class="terms">Free consultation · No upfront attorney fee · No fee unless there is a recovery</p>
        </div>

        <form class="review" action="/get-started/" method="get">
          <div class="review-heading">
            <div>
              <p>Free case review</p>
              <h2>Tell us what happened.</h2>
            </div>
            <span>~ 2 min</span>
          </div>
          <label>
            <span>Type of incident</span>
            <select name="type" required>
              <option value="">Select one</option>
              <option value="rear-end">Rear-end collision</option>
              <option value="car">Car accident</option>
              <option value="truck">Truck accident</option>
              <option value="motorcycle">Motorcycle accident</option>
              <option value="other">Something else</option>
            </select>
          </label>
          <label>
            <span>When did it happen?</span>
            <select name="when" required>
              <option value="">Select one</option>
              <option value="week">Within the last week</option>
              <option value="month">Within the last month</option>
              <option value="year">Within the last year</option>
              <option value="older">More than a year ago</option>
            </select>
          </label>
          <button type="submit">Continue <span>→</span></button>
          <small>No obligation. Submitting this form does not create an attorney-client relationship.</small>
        </form>
      </section>

      <div class="trust-row" aria-label="Service principles">
        <span>Free consultation</span>
        <span>Direct communication</span>
        <span>California cases</span>
        <span>Contingency fee</span>
      </div>

      <section class="statement" id="approach">
        <p class="section-label">Our approach</p>
        <h2>A difficult process<br />made easier to navigate.</h2>
        <div class="statement-copy">
          <p>After a crash, even ordinary tasks can feel complicated. Our job is to bring order to the legal side: protect the evidence, deal with insurers, document the harm, and keep the case moving.</p>
          <a href="/get-started/">Talk with us <span>→</span></a>
        </div>
      </section>

      <section class="principles">
        <article>
          <span>01</span>
          <h3>Know what happens next</h3>
          <p>Clear explanations, realistic expectations, and a defined next step.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Reach the people handling your case</h3>
          <p>Direct communication without wondering whether anyone is listening.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Build the claim around the evidence</h3>
          <p>Medical records, lost income, liability facts, and the effect on daily life.</p>
        </article>
      </section>

      <section class="cases" id="cases">
        <div class="cases-intro">
          <p class="section-label">Cases we handle</p>
          <h2>Focused on serious injury claims.</h2>
          <p>We represent people injured by unsafe driving and preventable collisions throughout California.</p>
        </div>
        <div class="case-links">
          {practiceAreas.map(([label, href]) => (
            <a href={href}><span>{label}</span><b>↗</b></a>
          ))}
        </div>
      </section>

      <section class="process">
        <p class="section-label">What happens next</p>
        <div class="process-grid">
          <h2>Start with a conversation.</h2>
          <ol>
            <li><span>1</span><div><h3>Share the basics</h3><p>Tell us when the crash happened, how you were hurt, and where things stand now.</p></div></li>
            <li><span>2</span><div><h3>Get an initial assessment</h3><p>We explain the issues that may matter and whether your case fits our practice.</p></div></li>
            <li><span>3</span><div><h3>Decide how to proceed</h3><p>If we can help, the fee agreement and next steps are explained before you decide.</p></div></li>
          </ol>
        </div>
      </section>

      <section class="faq" id="questions">
        <div>
          <p class="section-label">Common questions</p>
          <h2>Useful answers,<br />without the sales pitch.</h2>
        </div>
        <div class="faq-list">
          <details>
            <summary>Do I need a lawyer if the other driver was clearly at fault?<span>+</span></summary>
            <p>Clear fault can simplify one part of a claim, but insurance coverage, medical causation, and the value of future care may still be disputed. A consultation can help you assess those issues before you accept an offer.</p>
          </details>
          <details>
            <summary>Should I give the insurer a recorded statement?<span>+</span></summary>
            <p>You can speak with a lawyer before giving a recorded statement. Avoid guessing, minimizing injuries, or agreeing to language you do not understand.</p>
          </details>
          <details>
            <summary>What will it cost to speak with you?<span>+</span></summary>
            <p>The initial consultation is free. If the firm accepts your case, the written agreement will explain the contingency fee and responsibility for case costs.</p>
          </details>
        </div>
      </section>

      <section class="final">
        <div>
          <p>Free case review</p>
          <h2>Let’s make the next step clear.</h2>
        </div>
        <a class="button button-light" href="/get-started/">Tell us what happened <span>→</span></a>
      </section>
    </main>

    <footer>
      <div class="footer-main">
        <a class="logo footer-logo" href="#top">rear ended</a>
        <p>Auto-collision injury attorneys<br />Los Angeles, California</p>
        <div><a href="tel:+12132865834">(213) 286-5834</a><a href="mailto:hello@gotrearended.com">hello@gotrearended.com</a></div>
      </div>
      <div class="footer-legal">
        <p>Attorney advertising. Prior results do not guarantee a similar outcome. This website provides general information only and does not constitute legal advice or create an attorney-client relationship.</p>
        <span>© {new Date().getFullYear()} Rear Ended</span>
      </div>
    </footer>

    <div class="mobile-bar">
      <a href="tel:+12132865834">Call</a>
      <a href="/get-started/">Free case review</a>
    </div>
  </div>
</BaseLayout>

<style>
  :global(body) { background: #fbfbf8; color: #171915; }
  :global(html) { scroll-padding-top: 80px; }
  .page { --ink: #171915; --muted: #65695f; --soft: #f2f3ed; --green: #138a4b; --line: #dfe1d9; max-width: 100%; background: #fbfbf8; font-family: var(--sans); }
  .header { height: 76px; max-width: 1240px; margin: 0 auto; padding: 0 30px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; border-bottom: 1px solid var(--line); }
  .logo { color: var(--ink); font-family: var(--wordmark); font-size: 28px; font-weight: 500; letter-spacing: .04em; line-height: 1; text-decoration: none; }
  nav { display: flex; gap: 30px; }
  nav a, .phone { color: var(--muted); font-size: 12px; font-weight: 600; text-decoration: none; }
  nav a:hover, .phone:hover { color: var(--ink); }
  .header-contact { display: flex; align-items: center; justify-content: flex-end; gap: 20px; }
  .small-button { min-height: 42px; padding: 0 17px; display: inline-flex; align-items: center; color: #fff; background: var(--ink); border-radius: 6px; font-size: 12px; font-weight: 700; text-decoration: none; }

  .hero { max-width: 1180px; min-height: 660px; margin: 0 auto; padding: 92px 30px; display: grid; grid-template-columns: 1.12fr .68fr; gap: 100px; align-items: center; }
  .kicker, .section-label { margin-bottom: 20px; color: var(--green); font-size: 10px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .hero h1 { margin: 0; max-width: 680px; font-size: clamp(50px,6vw,78px); font-weight: 800; letter-spacing: -.058em; line-height: .96; }
  .lede { max-width: 590px; margin-top: 25px; color: #494d45; font-size: 18px; line-height: 1.6; letter-spacing: -.018em; }
  .hero-actions { margin-top: 34px; display: flex; align-items: center; gap: 24px; }
  .button { min-height: 52px; padding: 0 22px; display: inline-flex; align-items: center; justify-content: space-between; gap: 36px; color: #fff; background: var(--ink); border: 1px solid var(--ink); border-radius: 6px; font-size: 13px; font-weight: 700; text-decoration: none; transition: background .15s, transform .15s; }
  .button:hover { background: #2a2d27; transform: translateY(-1px); }
  .call { min-height: 44px; display: inline-flex; align-items: center; color: var(--ink); font-size: 12.5px; font-weight: 700; text-underline-offset: 4px; }
  .terms { margin-top: 24px; color: #81857b; font-size: 10.5px; line-height: 1.6; }
  .review { padding: 30px; background: #fff; border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 18px 50px rgba(21,25,18,.07); }
  .review-heading { display: flex; justify-content: space-between; gap: 20px; padding-bottom: 25px; border-bottom: 1px solid var(--line); }
  .review-heading p { margin-bottom: 8px; color: var(--green); font-size: 9px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .review h2 { font-size: 24px; letter-spacing: -.035em; }
  .review-heading > span { color: #8a8e84; font-size: 10px; white-space: nowrap; }
  .review label { display: block; padding-top: 22px; }
  .review label > span { display: block; margin-bottom: 8px; color: #53574f; font-size: 11px; font-weight: 700; }
  .review select { width: 100%; min-height: 48px; padding: 0 13px; border: 1px solid #d5d8cf; border-radius: 5px; background: #fff; color: var(--ink); font: inherit; font-size: 13px; }
  .review button { width: 100%; min-height: 50px; margin-top: 22px; padding: 0 16px; display: flex; align-items: center; justify-content: space-between; border: 0; border-radius: 5px; background: var(--green); color: #fff; font: inherit; font-size: 13px; font-weight: 750; cursor: pointer; }
  .review small { display: block; margin-top: 13px; color: #8a8e84; font-size: 9px; line-height: 1.5; }
  .trust-row { min-height: 78px; padding: 20px 30px; display: flex; align-items: center; justify-content: center; gap: 40px 70px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--soft); }
  .trust-row span { color: #5d6158; font-size: 11px; font-weight: 650; }
  .trust-row span::before { content: '✓'; margin-right: 8px; color: var(--green); font-weight: 800; }

  .statement, .cases, .process, .faq { max-width: 1180px; margin: 0 auto; padding: 110px 30px; }
  .statement { display: grid; grid-template-columns: .4fr 1.1fr .72fr; gap: 50px; align-items: start; }
  .statement h2, .cases h2, .process h2, .faq h2 { font-size: clamp(34px,4.2vw,54px); line-height: 1.04; letter-spacing: -.048em; }
  .statement-copy { padding-top: 3px; }
  .statement-copy p, .cases-intro > p:last-child { color: var(--muted); font-size: 14px; line-height: 1.7; }
  .statement-copy a { margin-top: 28px; display: inline-flex; gap: 36px; color: var(--ink); font-size: 12px; font-weight: 750; text-underline-offset: 5px; }
  .principles { max-width: 1120px; margin: 0 auto 110px; display: grid; grid-template-columns: repeat(3,1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .principles article { min-height: 220px; padding: 30px 34px; border-right: 1px solid var(--line); }
  .principles article:last-child { border-right: 0; }
  .principles article > span { color: #979b91; font-size: 9px; font-weight: 800; }
  .principles h3 { margin-top: 50px; font-size: 17px; letter-spacing: -.025em; }
  .principles p { margin-top: 12px; color: var(--muted); font-size: 12px; line-height: 1.65; }

  .cases { display: grid; grid-template-columns: .72fr 1fr; gap: 100px; border-top: 1px solid var(--line); }
  .cases-intro > p:last-child { max-width: 410px; margin-top: 24px; }
  .case-links { border-top: 1px solid var(--ink); }
  .case-links a { min-height: 70px; display: flex; align-items: center; justify-content: space-between; color: var(--ink); border-bottom: 1px solid var(--line); font-size: 14px; font-weight: 650; text-decoration: none; transition: color .15s, padding .15s; }
  .case-links a:hover { padding-left: 8px; color: var(--green); }
  .case-links b { font-size: 13px; font-weight: 500; }
  .process { border-top: 1px solid var(--line); }
  .process-grid { display: grid; grid-template-columns: .72fr 1fr; gap: 100px; }
  .process ol { list-style: none; border-top: 1px solid var(--ink); }
  .process li { padding: 25px 0; display: grid; grid-template-columns: 34px 1fr; gap: 20px; border-bottom: 1px solid var(--line); }
  .process li > span { width: 24px; height: 24px; display: grid; place-items: center; color: var(--green); border: 1px solid #b9c9bd; border-radius: 50%; font-size: 9px; font-weight: 800; }
  .process h3 { font-size: 15px; letter-spacing: -.02em; }
  .process li p { margin-top: 7px; color: var(--muted); font-size: 12.5px; line-height: 1.6; }
  .faq { display: grid; grid-template-columns: .72fr 1fr; gap: 100px; border-top: 1px solid var(--line); }
  .faq-list { border-top: 1px solid var(--ink); }
  details { border-bottom: 1px solid var(--line); }
  summary { min-height: 78px; display: flex; align-items: center; justify-content: space-between; gap: 20px; cursor: pointer; list-style: none; font-size: 13.5px; font-weight: 700; }
  summary::-webkit-details-marker { display: none; }
  summary span { color: var(--green); font-size: 18px; font-weight: 400; }
  details[open] summary span { transform: rotate(45deg); }
  details p { max-width: 640px; padding: 0 38px 24px 0; color: var(--muted); font-size: 12.5px; line-height: 1.7; }
  .final { max-width: 1180px; min-height: 310px; margin: 0 auto 30px; padding: 60px; display: flex; align-items: center; justify-content: space-between; gap: 50px; background: var(--ink); color: #fff; border-radius: 8px; }
  .final p { margin-bottom: 12px; color: #9aa096; font-size: 10px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .final h2 { max-width: 650px; font-size: clamp(36px,4.5vw,58px); line-height: 1.02; letter-spacing: -.05em; }
  .button-light { flex: 0 0 auto; background: #fff; color: var(--ink); border-color: #fff; }
  .button-light:hover { background: #eff1eb; }

  footer { padding: 64px 30px 34px; background: #f0f1eb; border-top: 1px solid var(--line); }
  .footer-main, .footer-legal { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 40px; }
  .footer-main > p { color: var(--muted); font-size: 11.5px; line-height: 1.7; }
  .footer-main > div { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
  .footer-main > div a { color: var(--ink); font-size: 11.5px; text-decoration: none; }
  .footer-legal { grid-template-columns: 1fr auto; margin-top: 55px; padding-top: 22px; border-top: 1px solid #d6d9d0; color: #878b82; font-size: 9.5px; line-height: 1.6; }
  .footer-legal p { max-width: 740px; }
  .mobile-bar { display: none; }
  :global(.page a:focus-visible), :global(.page button:focus-visible), :global(.page select:focus-visible), :global(.page summary:focus-visible) { outline: 3px solid rgba(19,138,75,.35); outline-offset: 3px; }

  @media (max-width: 900px) {
    .header { grid-template-columns: 1fr auto; }
    .header nav, .phone { display: none; }
    .hero { grid-template-columns: 1fr; gap: 55px; }
    .review { max-width: 560px; }
    .statement { grid-template-columns: 1fr 1fr; }
    .statement .section-label { grid-column: 1 / -1; }
    .cases, .process-grid, .faq { grid-template-columns: 1fr; gap: 50px; }
  }
  @media (max-width: 640px) {
    :global(body) { padding-bottom: 62px; }
    .header { height: 66px; padding: 0 20px; }
    .logo { font-size: 24px; }
    .small-button { min-height: 40px; padding: 0 13px; }
    .hero { min-height: auto; padding: 70px 20px 58px; }
    .hero h1 { font-size: clamp(46px,13vw,62px); }
    .lede { font-size: 16px; }
    .hero-actions { align-items: stretch; flex-direction: column; gap: 8px; }
    .hero-actions .button { width: 100%; }
    .call { justify-content: center; }
    .review { padding: 22px; }
    .trust-row { justify-content: flex-start; gap: 14px 24px; }
    .statement, .cases, .process, .faq { padding: 76px 20px; }
    .statement { grid-template-columns: 1fr; gap: 30px; }
    .statement .section-label { grid-column: auto; }
    .principles { margin: 0 20px 76px; grid-template-columns: 1fr; }
    .principles article { min-height: auto; padding: 26px 4px; border-right: 0; border-bottom: 1px solid var(--line); }
    .principles article:last-child { border-bottom: 0; }
    .principles h3 { margin-top: 28px; }
    .final { min-height: 340px; margin: 0 10px 10px; padding: 38px 24px; align-items: flex-start; justify-content: center; flex-direction: column; }
    .final .button { width: 100%; }
    footer { padding: 55px 20px 30px; }
    .footer-main, .footer-legal { grid-template-columns: 1fr; }
    .footer-main > div { align-items: flex-start; }
    .footer-legal { gap: 18px; }
    .mobile-bar { height: 62px; display: grid; grid-template-columns: .72fr 1.28fr; position: fixed; z-index: 100; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1px solid var(--ink); }
    .mobile-bar a { display: flex; align-items: center; justify-content: center; color: var(--ink); text-decoration: none; font-size: 12px; font-weight: 750; }
    .mobile-bar a:last-child { background: var(--green); color: #fff; }
  }
</style>
