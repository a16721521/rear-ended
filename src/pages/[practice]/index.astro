}
@media (max-width: 480px) {
  .comp-grid { grid-template-columns: 1fr; }
}
@media (prefers-reduced-motion: reduce) {
  .step-item .step-num { box-shadow: none; background: var(--gradient); color: var(--black); }
}
</style>

<script>
// FAQ accordion
(function() {
  document.querySelectorAll('.faq-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item') as HTMLElement;
      const body = item.querySelector('.faq-body') as HTMLElement;
      const isOpen = item.classList.contains('open');

      document.querySelectorAll('.faq-item.open').forEach(open => {
        (open as HTMLElement).classList.remove('open');
        ((open as HTMLElement).querySelector('.faq-body') as HTMLElement).style.maxHeight = '0';
        (open.querySelector('.faq-trigger') as HTMLElement).setAttribute('aria-expanded', 'false');
      });

      if (!isOpen) {
        item.classList.add('open');
        body.style.maxHeight = body.scrollHeight + 'px';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
})();

// Stepped timeline fill
(function() {
  const steps = document.querySelectorAll('.playbook-section .step-item');
  if (!steps.length) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    steps.forEach(s => s.classList.add('active'));
    return;
  }
  const obs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { (e.target as HTMLElement).classList.add('active'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.5, rootMargin: '0px 0px -10% 0px' });
  steps.forEach(s => obs.observe(s));
})();
</script>
