---
import PageLayout from '../../layouts/PageLayout.astro';
import practiceAreas from '../../data/practice-areas.json';
import cities from '../../data/cities.json';

export function getStaticPaths() {
  return practiceAreas.map(practice => ({
    params: { practice: practice.slug },
    props: { practice },
  }));
}

const { practice } = Astro.props;
const siteOrigin = Astro.site?.origin ?? 'https://gotrearended.com';

const featuredCities = [...cities]
  .sort((a, b) => b.population - a.population)
  .slice(0, 20);

const injuryInfo: Record<string, { name: string; desc: string }> = {
  'whiplash': { name: 'Whiplash & Cervical Spine', desc: 'The most frequently dismissed injury — and one of the most debilitating. Chronic neck pain, limited range of motion, and radiating nerve pain that can last years.' },
  'traumatic brain injury': { name: 'Traumatic Brain Injury (TBI)', desc: 'Concussions and mild TBIs don\'t always show on initial CT scans but cause months of cognitive impairment, headaches, and personality changes.' },
  'spinal cord injury': { name: 'Spinal Cord Injuries', desc: 'Partial or complete spinal cord injuries cause permanent neurological deficits. High-value cases requiring life-care planning and long-term medical projections.' },
  'broken bones': { name: 'Broken Bones & Fractures', desc: 'Ribs, wrists, clavicle, pelvis, and femur fractures from impact. Surgery, hardware, and extended rehabilitation all factor into damages.' },
  'internal injuries': { name: 'Internal Injuries', desc: 'Organ lacerations, ruptures, and internal bleeding are common in high-impact incidents. Symptoms may be delayed — seek emergency care the same day.' },
  'road rash': { name: 'Road Rash & Abrasions', desc: 'Severe road rash can require skin grafts, cause permanent scarring, and lead to chronic pain and nerve damage.' },
  'fractures': { name: 'Fractures & Compound Breaks', desc: 'Compound fractures and multi-bone breaks requiring surgical repair with plates, screws, or rods. Long recovery with significant pain.' },
  'amputations': { name: 'Amputations', desc: 'Loss of a limb requires lifetime prosthetic costs, vocational rehabilitation, psychological counseling, and home modifications.' },
  'spinal injuries': { name: 'Spinal Injuries', desc: 'Herniated discs, vertebral fractures, and nerve compression causing permanent pain, numbness, and reduced mobility.' },
  'soft tissue injuries': { name: 'Soft Tissue & Nerve Damage', desc: 'Sprains, strains, torn ligaments, and peripheral nerve injuries cause real, ongoing functional limitations.' },
  'hip fractures': { name: 'Hip Fractures', desc: 'Often require surgical repair or total hip replacement, followed by months of rehabilitation and elevated risk of complications.' },
  'wrist fractures': { name: 'Wrist & Hand Fractures', desc: 'Distal radius fractures and ligament tears requiring surgery and extensive physical therapy. Loss of grip strength affects employment.' },
  'head injuries': { name: 'Head Injuries', desc: 'Skull fractures, concussions, and subdural hematomas. Even "minor" head injuries can cause persistent cognitive and physical symptoms.' },
  'knee injuries': { name: 'Knee Injuries', desc: 'ACL tears, meniscus damage, and patellar fractures frequently require surgery and months of rehabilitation.' },
  'shoulder injuries': { name: 'Shoulder Injuries', desc: 'Rotator cuff tears, dislocations, and labrum injuries causing chronic pain and limited range of motion.' },
  'internal organ damage': { name: 'Internal Organ Damage', desc: 'Ruptured organs, kidney damage, and abdominal injuries from blunt force trauma requiring emergency surgery.' },
  'crush injuries': { name: 'Crush Injuries', desc: 'Compression injuries causing compartment syndrome, tissue death, and permanent disability. Immediate surgical intervention is critical.' },
  'wrongful death': { name: 'Wrongful Death', desc: 'When negligence takes a life, surviving family can recover economic loss, loss of companionship, and funeral expenses.' },
  'severe burns': { name: 'Severe Burns', desc: 'Third-degree burns requiring skin grafts cause permanent disfigurement and chronic pain. Among the most expensive injury categories.' },
  'vision or hearing loss': { name: 'Vision or Hearing Loss', desc: 'Permanent sensory loss dramatically impacts quality of life, employment, and independence.' },
  'anoxic brain injury': { name: 'Anoxic Brain Injury', desc: 'Brain damage from oxygen deprivation causing permanent cognitive deficits, personality changes, and physical disability.' },
  'polytrauma': { name: 'Polytrauma', desc: 'Multiple simultaneous injuries creating compounding damage and dramatically longer recovery across multiple medical specialties.' },
  'multiple fractures': { name: 'Multiple Fractures', desc: 'Multiple simultaneous bone fractures requiring surgical repair, extended hospitalization, and months of rehabilitation.' },
  'fatal injuries from vehicle accidents': { name: 'Fatal Vehicle Collisions', desc: 'Surviving family can recover loss of financial support, funeral costs, and loss of companionship under California law.' },
  'workplace fatalities': { name: 'Workplace Fatalities', desc: 'May give rise to both wrongful death claims and workers\' compensation death benefits from multiple liable parties.' },
  'medical malpractice': { name: 'Medical Malpractice', desc: 'Healthcare provider negligence causing death requires expert medical testimony. Special procedural requirements apply.' },
  'product defects': { name: 'Product Defects', desc: 'Defective products causing death give rise to strict liability claims against manufacturers. No proof of negligence required.' },
  'dog bite injuries': { name: 'Dog Bite Injuries', desc: 'California strict liability means the owner is responsible regardless of the animal\'s history. Severe bites cause permanent scarring.' },
  'lacerations requiring reconstructive surgery': { name: 'Lacerations & Scarring', desc: 'Deep lacerations requiring reconstructive surgery cause permanent disfigurement and lasting non-economic damages.' },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: practice.faqs.map((faq: { q: string; a: string }) => ({
    '@type': 'Question',
    name: faq.q.replace(/{city}/g, 'Los Angeles'),
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a.replace(/{city}/g, 'Los Angeles'),
    },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: `FLM Law — ${practice.title}s`,
  description: practice.description,
  url: `${siteOrigin}/${practice.slug}/`,
  provider: { '@id': `${siteOrigin}/#organization` },
  areaServed: { '@type': 'State', name: 'California' },
};

const solParts = practice.statute_of_limitations.split('(');
const solValue = solParts[0].trim();
const solNote = (practice.statute_of_limitations.match(/\(([^)]+)\)/) || [])[1] || '';

const cityRe = /{city}/g;
const processedFaqs = practice.faqs.map((faq: { q: string; a: string }) => ({
  q: faq.q.replace(cityRe, 'Los Angeles'),
  a: faq.a.replace(cityRe, 'Los Angeles'),
}));
---

<PageLayout
  title={`${practice.title} in Los Angeles | FLM Law`}
  description={practice.description}
  schemas={[faqSchema, serviceSchema]}
>

<!-- ══════ HERO ══════ -->
<header class="ca-hero-bg">
  <div class="ca-hero">
    <nav class="ca-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="bc-sep" aria-hidden="true">/</span>
      <span class="bc-current" aria-current="page">{practice.shortTitle}</span>
    </nav>

    <h1 class="ca-headline">
      {practice.title}s.<br>
      <span class="dim">{practice.heroLine}</span>
    </h1>

    <p class="ca-sub">{practice.description}</p>

    <div class="ca-actions">
      <a href="/get-started/" class="btn-primary">Free case review <span class="arrow">&rarr;</span></a>
      <a href="tel:+12132865834" class="btn-secondary">Call (213) 286-5834</a>
    </div>

    <div class="ca-hero-meta">
      <span>No fee unless we win</span>
      <span>Free consultation, 24/7</span>
      <span>Se habla espa&ntilde;ol</span>
      <span>Serving all of California</span>
    </div>
  </div>
</header>

<!-- ══════ INTRO + FACT CARD ══════ -->
<section class="intro-section" id="overview">
  <div class="intro-copy">
    <p class="section-eyebrow reveal">{practice.shortTitle}</p>
    <h2 class="reveal">Time is not on your side. Insurance companies start working against you on day one.</h2>
    <p class="reveal d1">{practice.description}</p>
    <p class="reveal d1">
      The other side's insurer assigned an adjuster to your claim within 24 hours. That adjuster's only job is to close your case for as little as possible. They will call you, seem sympathetic, request a recorded statement, and make an offer that sounds reasonable but isn't. <strong>Do not speak with them before speaking with us.</strong>
    </p>
    <p class="reveal d1">
      FLM Law represents {practice.type} victims on pure contingency. We advance every litigation cost — investigation, expert witnesses, medical record compilation, depositions — and collect only as a percentage of what we recover. No recovery means no fee, period. Our interests and yours are identical: <strong>maximize your compensation.</strong>
    </p>
    <p class="reveal d1">
      California's pure comparative fault rule (<a href="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=CIV&sectionNum=1431.2" target="_blank" rel="noopener noreferrer">Civil Code &sect; 1431.2</a>) means you can recover even if you were partly at fault — your recovery is simply reduced by your share of responsibility. <a href="/get-started/">Contact us today</a> — the earlier we start building your case, the more evidence we can preserve.
    </p>
  </div>

  <aside class="fact-card reveal d2" aria-label="California legal facts">
    <div class="fact-card-head"><h3>Know your rights</h3></div>
    <div class="fact-row">
      <div class="fact-label">Filing deadline</div>
      <div class="fact-value">{solValue}</div>
      <div class="fact-note">{solNote}</div>
    </div>
    <div class="fact-row">
      <div class="fact-label">Government entity involved?</div>
      <div class="fact-value">6 months</div>
      <div class="fact-note"><a href="https://leginfo.legislature.ca.gov/faces/codes_displaySection.xhtml?lawCode=GOV&sectionNum=911.2" target="_blank" rel="noopener noreferrer">Gov. Code &sect; 911.2</a> — city, county, or state</div>
    </div>
    <div class="fact-row">
      <div class="fact-label">Partly at fault?</div>
      <div class="fact-value">Still recoverable</div>
      <div class="fact-note">Pure comparative fault — recovery reduced, not eliminated</div>
    </div>
    <div class="fact-row">
      <div class="fact-label">Cost to you</div>
      <div class="fact-value">$0 upfront</div>
      <div class="fact-note">Contingency — our fee comes from the recovery, or nothing</div>
    </div>
    <a href="tel:+12132865834" class="fact-card-cta">Call (213) 286-5834</a>
  </aside>
</section>

<!-- ══════ POST-INCIDENT PLAYBOOK ══════ -->
<section class="playbook-section" id="what-to-do">
  <div class="playbook-sticky">
    <p class="section-eyebrow reveal">After the incident</p>
    <h2 class="reveal">What to do next.</h2>
    <p class="reveal d1">
      The first hours after an incident determine more of your case than you realize. Evidence is time-sensitive — documentation fades, cameras overwrite, memories blur. Follow these steps exactly.
    </p>
    <a href="/get-started/" class="btn-primary reveal d2">Tell us what happened <span class="arrow">&rarr;</span></a>
  </div>

  <div class="steps-list">
    <div class="step-item reveal">
      <div class="step-num">1</div>
      <div class="step-body">
        <div class="step-tag">Immediately</div>
        <div class="step-title">Get to safety and call 911</div>
        <p>If you're in danger, move yourself to safety. Call 911 and get a police or incident report number. An official report is foundational to your claim. Get the responding officer's name and badge number.</p>
      </div>
    </div>

    <div class="step-item reveal d1">
      <div class="step-num">2</div>
      <div class="step-body">
        <div class="step-tag">At the scene</div>
        <div class="step-title">Document everything, right now</div>
        <p>Photograph <strong>all</strong> damage, the scene, conditions, and any visible injuries — yours and others'. If there are witnesses, get their names and phone numbers. Collect the other party's insurance info, license, and registration.</p>
      </div>
    </div>

    <div class="step-item reveal d2">
      <div class="step-num">3</div>
      <div class="step-body">
        <div class="step-tag">Same day — critical</div>
        <div class="step-title">See a doctor today. Not tomorrow.</div>
        <p>Adrenaline suppresses pain — you may feel fine and have serious injuries. A gap between the incident and your first medical visit becomes a gap in your claim. Insurers will argue your injuries weren't caused by the incident. Go to an ER, urgent care, or your doctor <strong>the same day</strong>.</p>
      </div>
    </div>

    <div class="step-item reveal">
      <div class="step-num">4</div>
      <div class="step-body">
        <div class="step-tag">Within 24 hours</div>
        <div class="step-title">Do not talk to any insurance adjuster</div>
        <p>The opposing insurer will call you quickly — they're trained to. <strong>Do not give a recorded statement.</strong> Do not accept a check. Do not say "I'm okay." Anything you say will be used to minimize your claim. Tell them your attorney handles all communications, then call us.</p>
      </div>
    </div>

    <div class="step-item reveal d1">
      <div class="step-num">5</div>
      <div class="step-body">
        <div class="step-tag">Within 48 hours</div>
        <div class="step-title">Preserve all evidence</div>
        <p>Save all text messages, emails, and correspondence related to the incident. Do not post about it on social media. Keep all medical records, receipts, and bills. Surveillance footage overwrites in 24–72 hours — act fast.</p>
      </div>
    </div>

    <div class="step-item reveal d2">
      <div class="step-num">6</div>
      <div class="step-body">
        <div class="step-tag">As soon as possible</div>
        <div class="step-title">Call FLM Law. Start building the case.</div>
        <p>The opposing side is already preserving evidence in their favor. We send preservation letters, retain investigators, and begin documenting before anything else is lost. The earlier we start, the stronger your case.</p>
      </div>
    </div>
  </div>
</section>

<!-- ══════ COMMON INJURIES ══════ -->
<section class="injuries-section" id="injuries">
  <div class="injuries-inner">
    <div class="injuries-header">
      <p class="section-eyebrow reveal" style="background:rgba(255,255,255,.5);-webkit-background-clip:text;background-clip:text;color:transparent;">Common injuries</p>
      <h2 class="section-heading reveal" style="color:var(--white)">The injuries insurers<br>try hardest to minimize.</h2>
      <p class="section-sub reveal d1" style="color:rgba(255,255,255,.45);max-width:560px;">Every injury below has been undervalued by insurance adjusters who argue it's "soft tissue only" or "pre-existing." We document, argue, and litigate each one.</p>
    </div>

    <div class="inj-grid">
      {practice.common_injuries.map((injury: string, i: number) => {
        const info = injuryInfo[injury.toLowerCase()] ?? { name: injury, desc: 'A serious injury that requires thorough medical documentation and expert testimony to properly value.' };
        const delay = i % 3 === 1 ? 'd1' : i % 3 === 2 ? 'd2' : '';
        return (
          <div class={`inj-item reveal ${delay}`}>
            <div class="inj-name">{info.name}</div>
            <div class="inj-desc">{info.desc}</div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<!-- ══════ INSURANCE TACTICS ══════ -->
<section class="tactics-section" id="insurance-tactics">
  <div class="tactics-inner">
    <div class="tactics-kicker">What adjusters don't tell you</div>
    <h2 class="tactics-heading reveal">How insurance companies close cases cheap. And what we do about it.</h2>
    <p class="tactics-sub reveal d1">Insurance adjusters are professionals whose performance is measured by how little they pay on each claim. Every tactic below has been used against our clients — before they called us.</p>

    <div class="tactics-grid">
      <div class="tactic-card reveal">
        <span class="tactic-num">Tactic 01</span>
        <div class="tactic-title">The fast call and the friendly voice</div>
        <div class="tactic-body">Adjusters call within 24–48 hours — sometimes within hours. They seem sympathetic, ask how you're feeling, and offer to "help get this resolved quickly." <strong>The goal is a recorded statement.</strong> Anything you say about your injuries or what happened will be used to establish a ceiling on your claim value.</div>
      </div>

      <div class="tactic-card reveal d1">
        <span class="tactic-num">Tactic 02</span>
        <div class="tactic-title">The quick-pay offer before you know your injuries</div>
        <div class="tactic-body">A check for $2,500 or $5,000 arrives within days, before you've finished treatment — often before you've fully understood your injuries. It comes with a release that <strong>permanently closes your claim</strong>. Signing a settlement release before fully healed is one of the most expensive mistakes injury victims make.</div>
      </div>

      <div class="tactic-card reveal d2">
        <span class="tactic-num">Tactic 03</span>
        <div class="tactic-title">Disputing or inflating your percentage of fault</div>
        <div class="tactic-body">California's comparative fault rule means the insurer directly profits from assigning you more of the blame. If they can argue you were 40% at fault instead of 0%, they cut your payout by 40%. <strong>They do this routinely, with little evidence.</strong> Our job is to build the factual record that defeats those arguments.</div>
      </div>

      <div class="tactic-card reveal d3">
        <span class="tactic-num">Tactic 04</span>
        <div class="tactic-title">The "independent" medical examination</div>
        <div class="tactic-body">Insurers request an IME — supposedly a neutral medical opinion — conducted by a physician the insurer pays repeatedly. Studies consistently show IME doctors reach favorable-to-insurer conclusions at rates far above treating physicians. <strong>We prepare clients for these exams</strong> and challenge IME opinions that contradict treating physician findings.</div>
      </div>

      <div class="tactic-card reveal">
        <span class="tactic-num">Tactic 05</span>
        <div class="tactic-title">Surveillance and social media monitoring</div>
        <div class="tactic-body">If your case has value, the insurer may hire investigators to follow you and monitor your social media for evidence that your injuries are exaggerated. A photo from a family event, a check-in at a gym, a single caption can be used to challenge your claim. <strong>We advise every client on protective measures</strong> from day one.</div>
      </div>

      <div class="tactic-card reveal d1">
        <span class="tactic-num">Tactic 06</span>
        <div class="tactic-title">Delaying until the statute runs out</div>
        <div class="tactic-body">In multi-year cases, some insurers deliberately slow-walk negotiations with the goal of running out the statute of limitations. When time expires, your right to sue is gone permanently. <strong>We calendar every deadline from day one</strong> and file suit if necessary to preserve your rights — regardless of where settlement talks stand.</div>
      </div>
    </div>

    <div class="tactics-cta">
      <a href="/get-started/" class="btn-primary">Get a free case review <span class="arrow">&rarr;</span></a>
      <span class="tactics-cta-note">No obligation. No upfront cost. We handle all communication with insurers.</span>
    </div>
  </div>
</section>

<!-- ══════ COMPENSATION ══════ -->
<section class="comp-section" id="compensation">
  <div class="comp-header">
    <p class="section-eyebrow reveal">What you can recover</p>
    <h2 class="section-heading reveal">Three categories of damages. We pursue all of them.</h2>
    <p class="section-sub reveal d1">California allows injury victims to recover the full spectrum of damages caused by another party's negligence. Here's what that means in practice.</p>
  </div>

  <div class="comp-grid">
    <div class="comp-col reveal">
      <div class="comp-col-head">
        <div class="comp-col-label">Category 01</div>
        <div class="comp-col-title">Economic Damages</div>
      </div>
      <div class="comp-items">
        <div class="comp-item">
          <div class="comp-item-name">All medical bills — past</div>
          <div class="comp-item-note">ER, hospitalization, surgery, specialists, imaging, PT, chiropractic</div>
        </div>
        <div class="comp-item">
          <div class="comp-item-name">All medical costs — future</div>
          <div class="comp-item-note">Projected treatment, surgery, medications, and long-term care if injury is permanent</div>
        </div>
        <div class="comp-item">
          <div class="comp-item-name">Lost wages</div>
          <div class="comp-item-note">Every day of work missed because of the incident or recovery</div>
        </div>
        <div class="comp-item">
          <div class="comp-item-name">Lost earning capacity</div>
          <div class="comp-item-note">Future income you can no longer earn due to permanent limitations</div>
        </div>
        <div class="comp-item">
          <div class="comp-item-name">Out-of-pocket expenses</div>
          <div class="comp-item-note">Transportation to medical appointments, home care, modifications to home or vehicle</div>
        </div>
      </div>
    </div>

    <div class="comp-col reveal d1">
      <div class="comp-col-head">
        <div class="comp-col-label">Category 02</div>
        <div class="comp-col-title">Non-Economic Damages</div>
      </div>
      <div class="comp-items">
        <div class="comp-item">
          <div class="comp-item-name">Pain and suffering</div>
          <div class="comp-item-note">Physical pain — past, ongoing, and future — caused by the incident and injuries</div>
        </div>
        <div class="comp-item">
          <div class="comp-item-name">Emotional distress</div>
          <div class="comp-item-note">Anxiety, PTSD, depression, phobias, and psychological trauma</div>
        </div>
        <div class="comp-item">
          <div class="comp-item-name">Loss of enjoyment of life</div>
          <div class="comp-item-note">Activities, hobbies, and relationships you can no longer participate in</div>
        </div>
        <div class="comp-item">
          <div class="comp-item-name">Disfigurement and scarring</div>
          <div class="comp-item-note">Visible scarring or permanent physical changes from the incident</div>
        </div>
        <div class="comp-item">
          <div class="comp-item-name">Loss of consortium</div>
          <div class="comp-item-note">Impact on your relationship with spouse or domestic partner — a separate recoverable element</div>
        </div>
      </div>
    </div>

    <div class="comp-col reveal d2">
      <div class="comp-col-head">
        <div class="comp-col-label">Category 03</div>
        <div class="comp-col-title">Property &amp; Special Damages</div>
      </div>
      <div class="comp-items">
        <div class="comp-item">
          <div class="comp-item-name">Vehicle repair or replacement</div>
          <div class="comp-item-note">Full fair-market value if totaled; full repair cost if repairable</div>
        </div>
        <div class="comp-item">
          <div class="comp-item-name">Rental car costs</div>
          <div class="comp-item-note">Transportation while your vehicle is being repaired or replaced</div>
        </div>
        <div class="comp-item">
          <div class="comp-item-name">Diminished vehicle value</div>
          <div class="comp-item-note">A repaired vehicle is worth less than an undamaged one — this is separately recoverable</div>
        </div>
        <div class="comp-item">
          <div class="comp-item-name">Personal property damage</div>
          <div class="comp-item-note">Phones, glasses, car seats, equipment damaged in the incident</div>
        </div>
        <div class="comp-item">
          <div class="comp-item-name">Punitive damages</div>
          <div class="comp-item-note">Available when conduct is egregious — DUI, deliberate acts, gross recklessness</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══════ WHY FLM ══════ -->
<section class="why-section" id="why-flm">
  <div class="why-inner">
    <div class="why-header">
      <div>
        <p class="section-eyebrow reveal">Why FLM Law</p>
        <h2 class="section-heading reveal">The difference between<br>a settlement and a fight.</h2>
      </div>
      <p class="section-sub reveal d1">Insurance companies track which firms litigate and which fold. Here's what separates us.</p>
    </div>

    <div class="diff-grid">
      <div class="diff-item reveal">
        <div class="diff-icon"><span class="material-symbols-outlined" style="font-size:20px;color:var(--white);font-variation-settings:'FILL' 0,'wght' 300,'GRAD' 0,'opsz' 24">gavel</span></div>
        <div class="diff-title">We try cases. And they know it.</div>
        <div class="diff-body">The single biggest driver of settlement value is whether the opposing insurer believes you'll go to trial. We prepare every case for trial from day one. Insurers that know us price their offers accordingly.</div>
      </div>
      <div class="diff-item reveal d1">
        <div class="diff-icon"><span class="material-symbols-outlined" style="font-size:20px;color:var(--white);font-variation-settings:'FILL' 0,'wght' 300,'GRAD' 0,'opsz' 24">search</span></div>
        <div class="diff-title">Full-resource investigation</div>
        <div class="diff-body">We retain accident reconstruction specialists, biomechanical engineers, and medical experts before we demand anything. Physical evidence, camera footage, and eyewitness accounts — we get them before they disappear.</div>
      </div>
      <div class="diff-item reveal d2">
        <div class="diff-icon"><span class="material-symbols-outlined" style="font-size:20px;color:var(--white);font-variation-settings:'FILL' 0,'wght' 300,'GRAD' 0,'opsz' 24">assignment</span></div>
        <div class="diff-title">Medical build that holds up</div>
        <div class="diff-body">A weak medical record is the most common reason claims settle for less than they're worth. We work with treating physicians to ensure documentation captures the full impact of every injury.</div>
      </div>
      <div class="diff-item reveal">
        <div class="diff-icon"><span class="material-symbols-outlined" style="font-size:20px;color:var(--white);font-variation-settings:'FILL' 0,'wght' 300,'GRAD' 0,'opsz' 24">schedule</span></div>
        <div class="diff-title">We never rush a settlement</div>
        <div class="diff-body">We don't settle until you've either completed treatment or a physician has established the permanence of your injuries. Settling before maximum medical improvement is one of the most costly mistakes in personal injury.</div>
      </div>
      <div class="diff-item reveal d1">
