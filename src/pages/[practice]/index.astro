  .injuries-inner { padding: 72px 20px; }
  .inj-grid { grid-template-columns: 1fr; }

  .tactics-inner { padding: 72px 20px; }
  .tactics-grid { grid-template-columns: 1fr; }

  .comp-section { padding: 72px 20px; }
  .comp-grid { grid-template-columns: 1fr; gap: 16px; }

  .why-inner { padding: 72px 20px; }
  .diff-grid { grid-template-columns: 1fr; }
  .why-header { flex-direction: column; align-items: flex-start; }

