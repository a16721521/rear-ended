---
import PageLayout from '../layouts/PageLayout.astro';
import practiceAreas from '../data/practice-areas.json';

const heroSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'FLM Law',
  url: 'https://gotrearended.com',
};

// Icons for practice-area cards, keyed by slug (Material Symbols Outlined)
const iconMap: Record<string, string> = {
  'car-accident-lawyer': 'directions_car',
  'truck-accident-lawyer': 'local_shipping',
  'motorcycle-accident-lawyer': 'two_wheeler',
  'slip-and-fall-lawyer': 'personal_injury',
  'uber-lyft-accident-lawyer': 'hail',
  'wrongful-death-lawyer': 'sentiment_dissatisfied',
  'catastrophic-injury-lawyer': 'emergency',
  'pedestrian-accident-lawyer': 'directions_walk',
  'premises-liability-lawyer': 'home_work',
};
---

<PageLayout
  title="Rear-End &amp; Auto Accident Lawyers | FLM Law"
  description="Got rear ended? Our auto-collision injury attorneys fight for maximum recovery after car, truck, motorcycle and rideshare crashes. Free review, no fee unless we win."
  ogImage="/hero.avif"
  schemas={[heroSchema]}
>

  <!-- ══════ HERO ══════ -->
  <div class="hero-bg">
    <div class="hero">
      <div class="hero-left">
        <div class="hero-eyebrow">Auto-collision injury attorneys · California</div>
        <h1 class="hero-headline">got<br><span class="grad">rear ended?</span></h1>
        <p class="hero-sub">
          The other driver hit you — we make them pay. Medical bills, lost wages, and the settlement you're actually owed. No fee unless we win.
        </p>
        <div class="hero-actions">
          <a href="/get-started/" class="btn btn--primary">Start your claim <span style="opacity:.55">→</span></a>
          <a href="tel:+12132865834" class="btn">(213) 286-5834</a>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════ TRUST STRIP ══════ -->
  <div style="border-top:1px solid var(--gray-200);border-bottom:1px solid var(--gray-200);">
    <div class="trust-strip">
      <span class="trust-label">Why us</span>
      <span class="trust-item">No fee unless we win</span>
      <span class="trust-item">Free case review</span>
      <span class="trust-item">No upfront costs</span>
      <span class="trust-item">Fast response</span>
    </div>
  </div>

  <!-- ══════ METRICS ══════ -->
  <div class="metrics-section">
    <div class="metric reveal">
      <div class="metric-value">$47<span class="accent">M</span>+</div>
      <div class="metric-label">Recovered</div>
      <div class="metric-sub">For clients in California</div>
    </div>
    <div class="metric reveal d1">
      <div class="metric-value">98<span class="accent">%</span></div>
      <div class="metric-label">Success rate</div>
      <div class="metric-sub">Favorable client outcomes</div>
    </div>
    <div class="metric reveal d2">
      <div class="metric-value">300<span class="accent">+</span></div>
      <div class="metric-label">Cases resolved</div>
      <div class="metric-sub">Across California</div>
    </div>
  </div>

  <!-- ══════ PRACTICE AREAS ══════ -->
  <div class="section">
    <p class="section-eyebrow reveal">Practice areas</p>
    <div class="practice-header">
      <h2 class="section-heading reveal">Every case,<br>fought to win.</h2>
      <p class="section-body reveal d1">We handle the most consequential personal injury and employment cases in California. No case is too complex. No opponent is too large.</p>
    </div>
    <div class="case-grid">
      {practiceAreas.map((p, i) => (
        <a href={`/${p.slug}/`} class:list={['case-item', 'reveal', i % 3 === 1 ? 'd1' : i % 3 === 2 ? 'd2' : '']}>
          <span class="material-symbols-outlined case-icon" aria-hidden="true">{iconMap[p.slug] ?? 'gavel'}</span>
          <div class="case-title">{p.shortTitle}</div>
          <div class="case-desc">{p.heroLine}</div>
        </a>
      ))}
    </div>
  </div>

  <!-- ══════ RESULTS (DARK) ══════ -->
  <div class="results-bg">
    <div class="results-section">
      <p class="section-eyebrow reveal">Results</p>
      <div class="results-header">
        <h2 class="results-heading reveal">The record speaks<br>for itself.</h2>
        <p class="results-sub reveal d1">We measure success the only way that matters — outcomes. Selected recent results. Past results do not guarantee similar outcomes.</p>
      </div>
      <div class="results-grid">
        <div class="result-item reveal">
          <div class="result-type">Premises Liability</div>
          <div class="result-amount">$6.1M</div>
          <div class="result-desc">Verdict — commercial property negligence, severe spinal cord injury</div>
        </div>
        <div class="result-item reveal d1">
          <div class="result-type">Car Accident</div>
          <div class="result-amount">$4.2M</div>
          <div class="result-desc">Settlement — motor vehicle collision, traumatic brain injury</div>
        </div>
        <div class="result-item reveal d2">
          <div class="result-type">Motorcycle Accident</div>
          <div class="result-amount">$3.1M</div>
          <div class="result-desc">Settlement — highway collision, multiple orthopedic injuries, surgery</div>
        </div>
        <div class="result-item reveal d3">
          <div class="result-type">Slip &amp; Fall</div>
          <div class="result-amount">$2.4M</div>
          <div class="result-desc">Settlement — commercial property negligence, lumbar fusion required</div>
        </div>
        <div class="result-item reveal d4">
          <div class="result-type">Wrongful Death</div>
          <div class="result-amount">$1.4M</div>
          <div class="result-desc">Settlement — pedestrian struck by commercial vehicle, surviving spouse</div>
        </div>
        <div class="result-item reveal d5">
          <div class="result-type">Rideshare Accident</div>
          <div class="result-amount">$1.1M</div>
          <div class="result-desc">Settlement — Uber collision, multiple fractures, surgery required</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════ DIFFERENTIATORS ══════ -->
  <div class="section">
    <p class="section-eyebrow reveal">Why FLM Law</p>
    <div class="diff-layout">
      <div class="diff-sticky">
        <h2 class="section-heading reveal">A different<br>kind of firm.</h2>
      </div>
      <div class="diff-items">
        <div class="diff-item reveal">
          <span class="diff-num">01</span>
          <div>
            <div class="diff-title">Transparent by design</div>
            <div class="diff-body">Real-time case tracking, document access, and direct attorney communication — all through a single portal. No more waiting for a callback to know where you stand.</div>
          </div>
        </div>
        <div class="diff-item reveal d1">
          <span class="diff-num">02</span>
          <div>
            <div class="diff-title">No fee unless you win</div>
            <div class="diff-body">Pure contingency. We absorb all upfront costs and litigation expenses. Our interests are completely aligned with yours — we only collect when you do.</div>
          </div>
        </div>
        <div class="diff-item reveal d2">
          <span class="diff-num">03</span>
          <div>
            <div class="diff-title">Technology-driven process</div>
            <div class="diff-body">We use modern tooling at every stage — from intake and discovery to case preparation and settlement negotiation. The result is faster timelines and better outcomes.</div>
          </div>
        </div>
        <div class="diff-item reveal d3">
          <span class="diff-num">04</span>
          <div>
            <div class="diff-title">We don't take every case</div>
            <div class="diff-body">Our selectivity is a feature. When we accept your case, we've done the due diligence. Every client receives the full force of our resources — not a fraction of our attention.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════ CTA ══════ -->
  <div class="cta-wrap">
    <div class="cta-inner">
      <h2 class="cta-heading reveal">Ready to<br>fight back?</h2>
      <p class="cta-sub reveal d1">Free consultation. No obligation. No fee unless we win.</p>
      <div class="cta-actions reveal d2">
        <a href="/get-started/" class="btn btn--primary" style="padding:15px 34px;font-size:15px;">Start your claim →</a>
        <a href="tel:+12132865834" class="btn" style="padding:15px 26px;font-size:14px;">(213) 286-5834</a>
      </div>
    </div>
  </div>

</PageLayout>

<style>
/* ── HERO ── */
.hero-bg {
  min-height: 100vh;
  background-color: var(--black);
  background-image:
    linear-gradient(90deg, rgba(6,10,8,.95) 0%, rgba(6,10,8,.82) 34%, rgba(6,10,8,.48) 66%, rgba(6,10,8,.34) 100%),
    radial-gradient(ellipse at 6% 44%, rgba(52,211,153,.20) 0%, transparent 46%),
    url('/hero.avif');
  background-size: cover;
  background-position: center, center, center 28%;
  background-repeat: no-repeat;
}
.hero {
  max-width: 1360px;
  margin: 0 auto;
  padding: 210px 52px 80px;
  display: flex;
  align-items: center;
  min-height: 100vh;
}
.hero-eyebrow {
  display: flex; align-items: center; gap: 10px;
  font-size: 11.5px; font-weight: 600; letter-spacing: .09em; text-transform: uppercase;
  color: rgba(255,255,255,.75);
  margin-bottom: 30px;
}
.hero-eyebrow::before { content: ''; width: 22px; height: 1px; background: var(--gradient); display: block; flex-shrink: 0; }
.hero-headline {
  font-size: clamp(52px, 7.2vw, 112px);
  line-height: .93; letter-spacing: -.038em; font-weight: 800;
  color: var(--white); margin-bottom: 32px;
}
.hero-headline .dim { color: rgba(255,255,255,.45); }
.hero-headline .grad { background: var(--gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
.hero-sub {
  font-size: 16.5px; color: rgba(255,255,255,.68);
  line-height: 1.62; letter-spacing: -.015em; font-weight: 400;
  max-width: 430px; margin-bottom: 48px;
}
.hero-actions { display: flex; align-items: center; gap: 14px; }
.hero-actions .btn--primary { background: var(--gradient); }
.hero-actions .btn--primary:hover { filter: brightness(1.08); box-shadow: 0 8px 28px var(--accent-glow); }
.hero-actions .btn {
  color: rgba(255,255,255,.85); border-color: rgba(255,255,255,.32); background: transparent;
}
.hero-actions .btn:hover { color: var(--white); border-color: rgba(255,255,255,.65); background: transparent; }

/* ── TRUST STRIP ── */
.trust-strip {
  padding: 22px 52px; display: flex; align-items: center; gap: 56px;
  max-width: 1360px; margin: 0 auto;
}
.trust-label {
  font-size: 11px; font-weight: 600; color: var(--gray-300);
  letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; flex-shrink: 0;
}
.trust-item {
  font-size: 12px; font-weight: 600; color: var(--gray-400);
  letter-spacing: .01em; white-space: nowrap; display: flex; align-items: center; gap: 8px;
}
.trust-item::before { content: ''; width: 5px; height: 5px; background: var(--gradient); border-radius: 50%; opacity: .5; }

/* ── METRICS ── */
.metrics-section {
  max-width: 1360px; margin: 0 auto; padding: 96px 52px;
  display: grid; grid-template-columns: repeat(3, 1fr);
  border-bottom: 1px solid var(--gray-200);
}
.metric { padding: 0 56px; border-right: 1px solid var(--gray-200); }
.metric:first-child { padding-left: 0; }
.metric:last-child { border-right: none; }
.metric-value { font-size: clamp(56px, 6.5vw, 92px); font-weight: 800; letter-spacing: -.048em; color: var(--black); line-height: 1; margin-bottom: 12px; }
.metric-value .accent { color: var(--accent); }
.metric-label { font-size: 15px; font-weight: 600; color: var(--black); letter-spacing: -.025em; margin-bottom: 4px; }
.metric-sub { font-size: 13px; color: var(--gray-400); letter-spacing: -.01em; }

/* ── SECTION SHARED ── */
.section { max-width: 1360px; margin: 0 auto; padding: 112px 52px; }
.section-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--gray-300); margin-bottom: 56px; }
.section-heading { font-size: clamp(32px, 3.8vw, 56px); font-weight: 800; letter-spacing: -.036em; line-height: .98; color: var(--black); margin-bottom: 24px; }
.section-body { font-size: 15.5px; color: var(--gray-500); line-height: 1.66; letter-spacing: -.015em; max-width: 400px; }
.practice-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; margin-bottom: 56px; }

/* ── PRACTICE AREAS ── */
.case-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--gray-200); border: 1px solid var(--gray-200); }
.case-item { background: var(--white); padding: 38px 36px 34px; cursor: pointer; position: relative; overflow: hidden; text-decoration: none; display: block; transition: background .25s ease; }
.case-item::after { content: ''; position: absolute; top: 0; left: 0; width: 0; height: 2px; background: var(--gradient); transition: width .5s cubic-bezier(.16,1,.3,1); }
.case-item:hover { background: var(--gray-100); }
.case-item:hover::after { width: 100%; }
.case-icon { font-size: 26px; line-height: 1; margin-bottom: 18px; color: var(--gray-400); display: block; transition: color .3s; font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; }
.case-item:hover .case-icon { color: var(--accent); }
.case-title { font-size: 16.5px; font-weight: 700; letter-spacing: -.035em; color: var(--black); margin-bottom: 9px; line-height: 1.2; transition: color .25s ease; }
.case-item:hover .case-title { color: var(--accent); }
.case-desc { font-size: 13px; color: var(--gray-400); line-height: 1.6; letter-spacing: -.01em; }

/* ── RESULTS (DARK) ── */
.results-bg { background: var(--black); }
.results-section { max-width: 1360px; margin: 0 auto; padding: 112px 52px; }
.results-section .section-eyebrow { color: rgba(255,255,255,.22); }
.results-header { display: grid; grid-template-columns: 1fr 1fr; gap: 96px; margin-bottom: 72px; align-items: end; }
.results-heading { font-size: clamp(36px, 4vw, 58px); font-weight: 800; letter-spacing: -.038em; line-height: .98; color: var(--white); }
.results-sub { font-size: 15.5px; color: rgba(255,255,255,.38); line-height: 1.66; letter-spacing: -.015em; }
.results-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(255,255,255,.07); border-radius: 16px; overflow: hidden; border: 1px solid rgba(255,255,255,.07); }
.result-item { background: var(--black); padding: 44px 40px; transition: background .2s; }
.result-item:hover { background: #0f0f0f; }
.result-type { font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.25); margin-bottom: 20px; }
.result-amount { font-size: 46px; font-weight: 800; letter-spacing: -.038em; color: var(--white); line-height: 1; margin-bottom: 14px; }
.result-desc { font-size: 13.5px; color: rgba(255,255,255,.42); line-height: 1.58; letter-spacing: -.01em; }

/* ── DIFFERENTIATORS ── */
.diff-layout { display: grid; grid-template-columns: 340px 1fr; gap: 96px; align-items: start; }
.diff-sticky { position: sticky; top: 96px; }
.diff-item { display: grid; grid-template-columns: 44px 1fr; gap: 24px; padding: 36px 0; border-bottom: 1px solid var(--gray-200); align-items: start; }
.diff-item:first-child { border-top: 1px solid var(--gray-200); }
.diff-num { font-size: 11.5px; font-weight: 700; color: var(--gray-300); letter-spacing: .04em; padding-top: 5px; }
.diff-title { font-size: 21px; font-weight: 700; letter-spacing: -.028em; color: var(--black); margin-bottom: 10px; line-height: 1.1; }
.diff-body { font-size: 14.5px; color: var(--gray-500); line-height: 1.66; letter-spacing: -.015em; max-width: 520px; }

/* ── CTA ── */
.cta-wrap {
  border-top: 1px solid rgba(255,255,255,.10);
  background-color: #0a5f47;
  /* Full-green mesh gradient, brightest at the bottom-left */
  background-image:
    radial-gradient(60% 80% at 8% 100%, rgba(152,251,152,.95) 0%, rgba(152,251,152,0) 70%),
    radial-gradient(46% 64% at 0% 60%, rgba(201,251,184,.80) 0%, rgba(201,251,184,0) 72%),
    radial-gradient(54% 74% at 30% 82%, rgba(52,211,153,.85) 0%, rgba(52,211,153,0) 72%),
    radial-gradient(70% 92% at 96% 6%, rgba(6,61,48,.95) 0%, rgba(6,61,48,0) 66%),
    radial-gradient(64% 84% at 100% 100%, rgba(13,110,80,.60) 0%, rgba(13,110,80,0) 62%),
    linear-gradient(135deg, #0f7d5a 0%, #0a5f47 55%, #063d30 100%);
}
.cta-inner { max-width: 760px; margin: 0 auto; padding: 136px 52px; text-align: center; }
.cta-heading { font-size: clamp(40px, 5.5vw, 80px); font-weight: 800; letter-spacing: -.042em; line-height: .93; color: var(--white); margin-bottom: 28px; }
.cta-sub { font-size: 16.5px; color: rgba(255,255,255,.75); line-height: 1.6; letter-spacing: -.015em; margin-bottom: 48px; }
.cta-actions { display: flex; align-items: center; justify-content: center; gap: 14px; }
.cta-actions .btn--primary { background: var(--white); color: var(--black); box-shadow: 0 8px 26px rgba(3,40,28,.30); }
.cta-actions .btn--primary:hover { filter: none; transform: translateY(-2px); box-shadow: 0 14px 36px rgba(3,40,28,.42); }
.cta-actions .btn { color: var(--white); border-color: rgba(255,255,255,.55); background: transparent; }
.cta-actions .btn:hover { color: var(--white); border-color: var(--white); background: rgba(255,255,255,.12); transform: translateY(-2px); }

/* ── MOBILE ── */
@media (max-width: 768px) {
  .hero { padding: 120px 20px 60px; min-height: 100svh; }
  .hero-headline { font-size: clamp(44px, 12vw, 72px); }
  .hero-sub { font-size: 15px; max-width: 100%; }
  .hero-actions { flex-direction: column; align-items: stretch; }
  .hero-actions .btn { width: 100%; justify-content: center; padding: 15px 20px; }

  .trust-strip { padding: 18px 20px; gap: 20px; overflow-x: auto; -webkit-overflow-scrolling: touch; flex-wrap: nowrap; scrollbar-width: none; }
  .trust-strip::-webkit-scrollbar { display: none; }

  .metrics-section { grid-template-columns: 1fr; padding: 52px 20px; gap: 0; }
  .metric { padding: 28px 0; border-right: none; border-bottom: 1px solid var(--gray-200); }
  .metric:last-child { border-bottom: none; }
  .metric:first-child { padding-left: 0; }

  .section { padding: 64px 20px; }
  .section-eyebrow { margin-bottom: 28px; }
  .practice-header { flex-direction: column; align-items: flex-start; gap: 16px; margin-bottom: 32px; }
  .section-body { max-width: 100%; }
  .case-grid { grid-template-columns: 1fr 1fr; }
  .case-item { padding: 24px 20px 22px; }
  .case-title { font-size: 14px; }
  .case-desc { font-size: 12px; }

  .results-section { padding: 64px 20px; }
  .results-header { grid-template-columns: 1fr; gap: 20px; margin-bottom: 40px; }
  .results-grid { grid-template-columns: 1fr; }
  .result-item { padding: 28px 24px; }
  .result-amount { font-size: 36px; }

  .diff-layout { grid-template-columns: 1fr; gap: 40px; }
  .diff-sticky { position: static; }
  .diff-item { grid-template-columns: 36px 1fr; gap: 16px; padding: 28px 0; }

  .cta-inner { padding: 80px 20px; }
  .cta-heading { font-size: clamp(36px, 10vw, 56px); }
  .cta-sub { font-size: 15px; }
  .cta-actions { flex-direction: column; align-items: stretch; }
  .cta-actions .btn { width: 100%; justify-content: center; }
}

@media (max-width: 420px) {
  .case-grid { grid-template-columns: 1fr; }
  .hero-headline { font-size: clamp(40px, 13vw, 60px); }
}
</style>
