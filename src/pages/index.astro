---
import PageLayout from '../layouts/PageLayout.astro';
import practiceAreas from '../data/practice-areas.json';
import cities from '../data/cities.json';

const heroSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'FLM Law',
  url: 'https://gotrearended.com',
};

const featuredCities = [...cities]
  .sort((a, b) => b.population - a.population)
  .slice(0, 20);
---

<PageLayout
  title="Rear-End &amp; Auto Accident Lawyers | FLM Law"
  description="Got rear ended? Our auto-collision injury attorneys fight for maximum recovery after car, truck, motorcycle and rideshare crashes. Free review, no fee unless we win."
  ogImage="/hero.avif"
  schemas={[heroSchema]}
>

  <!-- ══════ HERO ══════ -->
  <div class="hero-bg">
    <div class="hero">
      <div class="hero-left">
        <div class="hero-eyebrow">Auto-collision injury attorneys · California</div>
        <h1 class="hero-headline">got<br><span class="grad">rear ended?</span></h1>
        <p class="hero-sub">
          The other driver hit you — we make them pay. Medical bills, lost wages, and the settlement you're actually owed.
        </p>
        <div class="hero-actions">
          <a href="/get-started/" class="btn btn--primary">Start your claim <span style="opacity:.55">&rarr;</span></a>
          <a href="tel:+12132865834" class="btn">(213) 286-5834</a>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════ TRUST STRIP ══════ -->
  <div class="trust-bg">
    <div class="trust-strip">
      <div class="trust-item">
        <span class="material-symbols-outlined trust-icon" aria-hidden="true">verified</span>
        <div>
          <div class="trust-title">No fee unless we win</div>
          <div class="trust-note">Pure contingency</div>
        </div>
      </div>
      <div class="trust-item">
        <span class="material-symbols-outlined trust-icon" aria-hidden="true">schedule</span>
        <div>
          <div class="trust-title">Free consultation, 24/7</div>
          <div class="trust-note">Nights &amp; weekends</div>
        </div>
      </div>
      <div class="trust-item">
        <span class="material-symbols-outlined trust-icon" aria-hidden="true">payments</span>
        <div>
          <div class="trust-title">$0 upfront</div>
          <div class="trust-note">We advance all costs</div>
        </div>
      </div>
      <div class="trust-item">
        <span class="material-symbols-outlined trust-icon" aria-hidden="true">translate</span>
        <div>
          <div class="trust-title">Se habla espa&ntilde;ol</div>
          <div class="trust-note">Bilingual team</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════ METRICS ══════ -->
  <div class="metrics-section">
    <div class="metric reveal">
      <div class="metric-value">$47<span class="accent">M</span>+</div>
      <div class="metric-label">Recovered</div>
      <div class="metric-sub">For clients in California</div>
    </div>
    <div class="metric reveal d1">
      <div class="metric-value">98<span class="accent">%</span></div>
      <div class="metric-label">Success rate</div>
      <div class="metric-sub">Favorable client outcomes</div>
    </div>
    <div class="metric reveal d2">
      <div class="metric-value">300<span class="accent">+</span></div>
      <div class="metric-label">Cases resolved</div>
      <div class="metric-sub">Across California</div>
    </div>
  </div>

  <!-- ══════ PRACTICE AREAS ══════ -->
  <div class="pa-bg">
    <div class="section">
      <p class="section-eyebrow reveal">Practice areas</p>
      <div class="practice-header">
        <h2 class="section-heading reveal">Every case,<br>fought to win.</h2>
        <p class="section-body reveal d1">We handle the most consequential personal injury cases in California. No case is too complex. No opponent is too large.</p>
      </div>
      <div class="case-grid">
        <a href="/car-accident-lawyer/" class="case-item reveal">
          <span class="material-symbols-outlined case-icon" aria-hidden="true">directions_car</span>
          <div class="case-title">Car Accidents</div>
          <div class="case-desc">Collisions, rear-ends, T-bones, and hit-and-run. Full recovery for all auto liability claims.</div>
        </a>
        <a href="/truck-accident-lawyer/" class="case-item reveal d1">
          <span class="material-symbols-outlined case-icon" aria-hidden="true">local_shipping</span>
          <div class="case-title">Truck & Commercial Vehicle</div>
          <div class="case-desc">18-wheelers, delivery fleets, and semi-trucks. Complex multi-party liability handled in full.</div>
        </a>
        <a href="/uber-lyft-accident-lawyer/" class="case-item reveal d2">
          <span class="material-symbols-outlined case-icon" aria-hidden="true">hail</span>
          <div class="case-title">Rideshare Accidents</div>
          <div class="case-desc">Uber, Lyft, and on-demand transport. We cut through layered insurance disputes fast.</div>
        </a>
        <a href="/slip-and-fall-lawyer/" class="case-item reveal">
          <span class="material-symbols-outlined case-icon" aria-hidden="true">personal_injury</span>
          <div class="case-title">Slip & Fall</div>
          <div class="case-desc">Wet floors, uneven surfaces, dark stairwells. Premises liability cases on full contingency.</div>
        </a>
        <a href="/catastrophic-injury-lawyer/" class="case-item reveal d1">
          <span class="material-symbols-outlined case-icon" aria-hidden="true">emergency</span>
          <div class="case-title">Catastrophic Injury</div>
          <div class="case-desc">Spinal cord, traumatic brain injury, and amputation. Lifetime damages, fully analyzed.</div>
        </a>
        <a href="/motorcycle-accident-lawyer/" class="case-item reveal d2">
          <span class="material-symbols-outlined case-icon" aria-hidden="true">two_wheeler</span>
          <div class="case-title">Motorcycle Accidents</div>
          <div class="case-desc">Severe injuries, lane-splitting disputes, helmet defense. We fight hard for riders.</div>
        </a>
        <a href="/pedestrian-accident-lawyer/" class="case-item reveal">
          <span class="material-symbols-outlined case-icon" aria-hidden="true">directions_walk</span>
          <div class="case-title">Pedestrian Accidents</div>
          <div class="case-desc">Crosswalk and sidewalk collisions. Often catastrophic — we pursue every dollar.</div>
        </a>
        <a href="/wrongful-death-lawyer/" class="case-item reveal d1">
          <span class="material-symbols-outlined case-icon" aria-hidden="true">sentiment_dissatisfied</span>
          <div class="case-title">Wrongful Death</div>
          <div class="case-desc">Justice and financial recovery for families who've lost someone to negligence.</div>
        </a>
        <a href="/premises-liability-lawyer/" class="case-item reveal d2">
          <span class="material-symbols-outlined case-icon" aria-hidden="true">home_work</span>
          <div class="case-title">Premises Liability</div>
          <div class="case-desc">Unsafe properties, inadequate security, negligent maintenance. Owners are accountable.</div>
        </a>
      </div>
    </div>
  </div>

  <!-- ══════ HOW IT WORKS ══════ -->
  <div class="section">
    <p class="section-eyebrow reveal">How it works</p>
    <h2 class="section-heading reveal" style="margin-bottom:64px;">Three steps.<br>No surprises.</h2>

    <div class="process-grid">
      <div class="process-step reveal">
        <div class="process-num">01</div>
        <div class="process-icon-wrap"><span class="material-symbols-outlined" aria-hidden="true">phone_iphone</span></div>
        <h3 class="process-title">Tell us what happened</h3>
        <p class="process-body">Call us or fill out the form. In 15 minutes we'll know whether you have a case — and what it could be worth. Free. No obligation.</p>
      </div>
      <div class="process-step reveal d1">
        <div class="process-num">02</div>
        <div class="process-icon-wrap"><span class="material-symbols-outlined" aria-hidden="true">search</span></div>
        <h3 class="process-title">We investigate &amp; build</h3>
        <p class="process-body">We gather evidence, retain experts, compile medical records, and handle every conversation with the insurer. You focus on recovering.</p>
      </div>
      <div class="process-step reveal d2">
        <div class="process-num">03</div>
        <div class="process-icon-wrap"><span class="material-symbols-outlined" aria-hidden="true">payments</span></div>
        <h3 class="process-title">You get compensated</h3>
        <p class="process-body">We negotiate aggressively or take them to trial. You receive your settlement or verdict — we only get paid when you do.</p>
      </div>
    </div>
  </div>

  <!-- ══════ RESULTS (DARK) ══════ -->
  <div class="results-bg">
    <div class="results-section">
      <p class="section-eyebrow reveal">Results</p>
      <div class="results-header">
        <h2 class="results-heading reveal">The record speaks<br>for itself.</h2>
        <p class="results-sub reveal d1">We measure success the only way that matters — outcomes. Selected recent results. Past results do not guarantee similar outcomes.</p>
      </div>
      <div class="results-grid">
        <div class="result-item reveal">
          <div class="result-type">Premises Liability</div>
          <div class="result-amount">$6.1M</div>
          <div class="result-desc">Verdict — commercial property negligence, severe spinal cord injury</div>
        </div>
        <div class="result-item reveal d1">
          <div class="result-type">Car Accident</div>
          <div class="result-amount">$4.2M</div>
          <div class="result-desc">Settlement — motor vehicle collision, traumatic brain injury</div>
        </div>
        <div class="result-item reveal d2">
          <div class="result-type">Motorcycle Accident</div>
          <div class="result-amount">$3.1M</div>
          <div class="result-desc">Settlement — highway collision, multiple orthopedic injuries, surgery</div>
        </div>
        <div class="result-item reveal d3">
          <div class="result-type">Slip &amp; Fall</div>
          <div class="result-amount">$2.4M</div>
          <div class="result-desc">Settlement — commercial property negligence, lumbar fusion required</div>
        </div>
        <div class="result-item reveal d4">
          <div class="result-type">Wrongful Death</div>
          <div class="result-amount">$1.4M</div>
          <div class="result-desc">Settlement — pedestrian struck by commercial vehicle, surviving spouse</div>
        </div>
        <div class="result-item reveal d5">
          <div class="result-type">Rideshare Accident</div>
          <div class="result-amount">$1.1M</div>
          <div class="result-desc">Settlement — Uber collision, multiple fractures, surgery required</div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════ DIFFERENTIATORS ══════ -->
  <div class="section">
    <p class="section-eyebrow reveal">Why FLM Law</p>
    <div class="diff-layout">
      <div class="diff-sticky">
        <h2 class="section-heading reveal">A different<br>kind of firm.</h2>
      </div>
      <div class="diff-items">
        <div class="diff-item reveal">
          <span class="diff-num">01</span>
          <div>
            <div class="diff-title">Transparent by design</div>
            <div class="diff-body">Real-time case tracking, document access, and direct attorney communication — all through a single portal. No more waiting for a callback to know where you stand.</div>
          </div>
        </div>
        <div class="diff-item reveal d1">
          <span class="diff-num">02</span>
          <div>
            <div class="diff-title">No fee unless you win</div>
            <div class="diff-body">Pure contingency. We absorb all upfront costs and litigation expenses. Our interests are completely aligned with yours — we only collect when you do.</div>
          </div>
        </div>
        <div class="diff-item reveal d2">
          <span class="diff-num">03</span>
          <div>
            <div class="diff-title">Technology-driven process</div>
            <div class="diff-body">We use modern tooling at every stage — from intake and discovery to case preparation and settlement negotiation. The result is faster timelines and better outcomes.</div>
          </div>
        </div>
        <div class="diff-item reveal d3">
          <span class="diff-num">04</span>
          <div>
            <div class="diff-title">We don't take every case</div>
            <div class="diff-body">Our selectivity is a feature. When we accept your case, we've done the due diligence. Every client receives the full force of our resources — not a fraction of our attention.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ══════ STATUTE OF LIMITATIONS ══════ -->
  <div class="statute-bg">
    <div class="statute-inner">
      <div class="statute-left">
        <div class="statute-tag">Statute of limitations</div>
        <h2 class="statute-heading reveal">California gives you two years.<br>Government claims: six months.</h2>
        <p class="statute-body reveal d1">
          Under <strong>CCP &sect; 335.1</strong>, you have two years from the date of your injury to file suit. Claims against government entities — city buses, CalTrans roads, public facilities — must be filed within six months under <strong>Gov. Code &sect; 911.2</strong>. Once the window closes, it cannot be reopened.
        </p>
      </div>
      <div class="statute-cta">
        <a href="/get-started/" class="btn btn--primary">Start your case today &rarr;</a>
        <a href="tel:+12132865834" class="btn btn--ghost">Call (213) 286-5834</a>
      </div>
    </div>
  </div>

  <!-- ══════ SERVICE AREA ══════ -->
  <div class="area-bg">
    <div class="area-inner">
      <h2 class="area-heading reveal">Serving Los Angeles County &amp; beyond.</h2>
      <p class="area-sub reveal d1">Personal injury cases accepted throughout Southern California. We come to you.</p>

      <div class="area-chips reveal d2">
        {featuredCities.map(city => (
          <a class="area-chip" href={`/car-accident-lawyer/${city.slug}/`}>{city.name}</a>
        ))}
      </div>

      <div class="area-cta-band reveal">
        <div class="area-cta-text">
          <h3>Ready to fight back?</h3>
          <p>Evidence disappears. Deadlines are real. Free consultation — no obligation, no fee unless we win.</p>
        </div>
        <div class="area-cta-actions">
          <a href="/get-started/" class="btn btn--primary" style="padding:16px 36px;font-size:15px;background:var(--white);color:var(--black);box-shadow:0 8px 26px rgba(3,40,28,.30);">Start your claim &rarr;</a>
          <a href="tel:+12132865834" class="btn btn--ghost" style="padding:16px 28px;font-size:15px;">(213) 286-5834</a>
        </div>
      </div>
    </div>
  </div>

</PageLayout>

<style>
/* ── HERO ── */
.hero-bg {
  min-height: 100vh;
  background-color: var(--black);
  background-image:
    linear-gradient(90deg, rgba(6,10,8,.95) 0%, rgba(6,10,8,.82) 34%, rgba(6,10,8,.48) 66%, rgba(6,10,8,.34) 100%),
    radial-gradient(ellipse at 6% 44%, rgba(52,211,153,.20) 0%, transparent 46%),
    url('/hero.avif');
  background-size: cover;
  background-position: center, center, center 28%;
  background-repeat: no-repeat;
}
.hero {
  max-width: 1360px;
  margin: 0 auto;
  padding: 210px 52px 80px;
  display: flex;
  align-items: center;
  min-height: 100vh;
}
.hero-eyebrow {
  display: flex; align-items: center; gap: 10px;
  font-size: 11.5px; font-weight: 600; letter-spacing: .09em; text-transform: uppercase;
  color: rgba(255,255,255,.75);
  margin-bottom: 30px;
}
.hero-eyebrow::before { content: ''; width: 22px; height: 1px; background: var(--gradient); display: block; flex-shrink: 0; }
.hero-headline {
  font-size: clamp(52px, 7.2vw, 112px);
  line-height: .93; letter-spacing: -.038em; font-weight: 800;
  color: var(--white); margin-bottom: 32px;
}
.hero-headline .grad { background: var(--gradient); -webkit-background-clip: text; background-clip: text; color: transparent; }
.hero-sub {
  font-size: 16.5px; color: rgba(255,255,255,.68);
  line-height: 1.62; letter-spacing: -.015em; font-weight: 400;
  max-width: 430px; margin-bottom: 48px;
}
.hero-actions { display: flex; align-items: center; gap: 14px; }
.hero-actions .btn--primary { background: var(--gradient); }
.hero-actions .btn--primary:hover { filter: brightness(1.08); box-shadow: 0 8px 28px var(--accent-glow); }
.hero-actions .btn {
  color: rgba(255,255,255,.85); border-color: rgba(255,255,255,.32); background: transparent;
}
.hero-actions .btn:hover { color: var(--white); border-color: rgba(255,255,255,.65); background: transparent; }

/* ── TRUST STRIP (#6 — beefed up) ── */
.trust-bg { border-top: 1px solid var(--gray-200); border-bottom: 1px solid var(--gray-200); }
.trust-strip {
  max-width: 1360px; margin: 0 auto; padding: 28px 52px;
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px;
}
.trust-item { display: flex; align-items: center; gap: 14px; }
.trust-icon { font-size: 22px; color: var(--accent); flex-shrink: 0; font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; }
.trust-title { font-size: 14px; font-weight: 700; color: var(--black); letter-spacing: -.02em; line-height: 1.3; }
.trust-note { font-size: 12px; color: var(--gray-400); letter-spacing: -.01em; margin-top: 1px; }

/* ── METRICS ── */
.metrics-section {
  max-width: 1360px; margin: 0 auto; padding: 96px 52px;
  display: grid; grid-template-columns: repeat(3, 1fr);
  border-bottom: 1px solid var(--gray-200);
}
.metric { padding: 0 56px; border-right: 1px solid var(--gray-200); }
.metric:first-child { padding-left: 0; }
.metric:last-child { border-right: none; }
.metric-value { font-size: clamp(56px, 6.5vw, 92px); font-weight: 800; letter-spacing: -.048em; color: var(--black); line-height: 1; margin-bottom: 12px; }
.metric-value .accent { color: var(--accent); }
.metric-label { font-size: 15px; font-weight: 600; color: var(--black); letter-spacing: -.025em; margin-bottom: 4px; }
.metric-sub { font-size: 13px; color: var(--gray-400); letter-spacing: -.01em; }

/* ── SECTION SHARED ── */
.section { max-width: 1360px; margin: 0 auto; padding: 112px 52px; }

/* #5 — gradient eyebrows to match practice pages */
.section-eyebrow {
  font-size: 11.5px; font-weight: 600; letter-spacing: .09em; text-transform: uppercase;
  background: var(--gradient); -webkit-background-clip: text; background-clip: text; color: transparent;
  margin-bottom: 56px;
  display: flex; align-items: center; gap: 10px;
}
.section-eyebrow::before { content: ''; width: 22px; height: 1px; background: var(--gradient); display: block; flex-shrink: 0; }

.section-heading { font-size: clamp(32px, 3.8vw, 56px); font-weight: 800; letter-spacing: -.036em; line-height: .98; color: var(--black); margin-bottom: 24px; }
.section-body { font-size: 15.5px; color: var(--gray-500); line-height: 1.66; letter-spacing: -.015em; max-width: 400px; }
.practice-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; margin-bottom: 56px; }

/* #4 — off-white bg for practice areas */
.pa-bg { background: var(--off-white); border-top: 1px solid var(--gray-200); border-bottom: 1px solid var(--gray-200); }
.pa-bg .section { padding-top: 112px; padding-bottom: 112px; }

/* ── PRACTICE AREAS ── */
.case-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--gray-200); border: 1px solid var(--gray-200); }
.case-item { background: var(--white); padding: 38px 36px 34px; cursor: pointer; position: relative; overflow: hidden; text-decoration: none; display: block; transition: background .25s ease; }
.case-item::after { content: ''; position: absolute; top: 0; left: 0; width: 0; height: 2px; background: var(--gradient); transition: width .5s cubic-bezier(.16,1,.3,1); }
.case-item:hover { background: var(--gray-100); }
.case-item:hover::after { width: 100%; }
.case-icon { font-size: 26px; line-height: 1; margin-bottom: 18px; color: var(--gray-400); display: block; transition: color .3s; font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; }
.case-item:hover .case-icon { color: var(--accent); }
.case-title { font-size: 16.5px; font-weight: 700; letter-spacing: -.035em; color: var(--black); margin-bottom: 9px; line-height: 1.2; transition: color .25s ease; }
.case-item:hover .case-title { color: var(--accent); }
.case-desc { font-size: 13px; color: var(--gray-400); line-height: 1.6; letter-spacing: -.01em; }

/* ── HOW IT WORKS (#7) ── */
.process-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; }
.process-step { position: relative; }
.process-num { font-size: 11px; font-weight: 800; letter-spacing: .08em; color: var(--gray-300); margin-bottom: 24px; }
.process-icon-wrap {
  width: 56px; height: 56px; border-radius: 14px; background: var(--black);
  display: flex; align-items: center; justify-content: center; margin-bottom: 24px;
}
.process-icon-wrap .material-symbols-outlined { font-size: 24px; color: var(--white); font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; }
.process-title { font-size: 20px; font-weight: 700; letter-spacing: -.03em; color: var(--black); margin-bottom: 10px; }
.process-body { font-size: 14.5px; color: var(--gray-500); line-height: 1.68; letter-spacing: -.012em; max-width: 340px; }

/* ── RESULTS (DARK) ── */
.results-bg { background: var(--black); }
.results-section { max-width: 1360px; margin: 0 auto; padding: 112px 52px; }
.results-section .section-eyebrow { background: none; -webkit-background-clip: unset; background-clip: unset; color: rgba(255,255,255,.22); }
.results-section .section-eyebrow::before { background: rgba(255,255,255,.22); }
.results-header { display: grid; grid-template-columns: 1fr 1fr; gap: 96px; margin-bottom: 72px; align-items: end; }
.results-heading { font-size: clamp(36px, 4vw, 58px); font-weight: 800; letter-spacing: -.038em; line-height: .98; color: var(--white); }
.results-sub { font-size: 15.5px; color: rgba(255,255,255,.38); line-height: 1.66; letter-spacing: -.015em; }
.results-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(255,255,255,.07); border-radius: 16px; overflow: hidden; border: 1px solid rgba(255,255,255,.07); }
.result-item { background: var(--black); padding: 44px 40px; transition: background .2s; }
.result-item:hover { background: #0f0f0f; }
.result-type { font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.25); margin-bottom: 20px; }
.result-amount { font-size: 46px; font-weight: 800; letter-spacing: -.038em; color: var(--white); line-height: 1; margin-bottom: 14px; }
.result-desc { font-size: 13.5px; color: rgba(255,255,255,.42); line-height: 1.58; letter-spacing: -.01em; }

/* ── DIFFERENTIATORS ── */
.diff-layout { display: grid; grid-template-columns: 340px 1fr; gap: 96px; align-items: start; }
.diff-sticky { position: sticky; top: 96px; }
.diff-item { display: grid; grid-template-columns: 44px 1fr; gap: 24px; padding: 36px 0; border-bottom: 1px solid var(--gray-200); align-items: start; }
.diff-item:first-child { border-top: 1px solid var(--gray-200); }
.diff-num { font-size: 11.5px; font-weight: 700; color: var(--gray-300); letter-spacing: .04em; padding-top: 5px; }
.diff-title { font-size: 21px; font-weight: 700; letter-spacing: -.028em; color: var(--black); margin-bottom: 10px; line-height: 1.1; }
.diff-body { font-size: 14.5px; color: var(--gray-500); line-height: 1.66; letter-spacing: -.015em; max-width: 520px; }

