---
import practiceAreas from '../data/practice-areas.json';

const navLinks = [
  { href: '/car-accident-lawyer/', label: 'Car Accidents' },
  { href: '/truck-accident-lawyer/', label: 'Truck' },
  { href: '/motorcycle-accident-lawyer/', label: 'Motorcycle' },
  { href: '/uber-lyft-accident-lawyer/', label: 'Rideshare' },
];

const currentPath = Astro.url.pathname;
---

<nav id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="FLM Law — home">
      <span class="nav-wordmark">FLM Law</span>
    </a>
    <ul class="nav-links">
      {navLinks.map(({ href, label }) => (
        <li>
          <a href={href} class:list={[{ 'is-active': currentPath.startsWith(href) }]}>{label}</a>
        </li>
      ))}
    </ul>
    <div class="nav-right">
      <a href="tel:+12132865834" class="nav-phone">(213) 286-5834</a>
      <a href="/#contact" class="nav-cta">Free case review →</a>
      <button class="nav-burger" id="navBurger" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<div class="mobile-menu" id="mobileMenu">
  <ul>
    {navLinks.map(({ href, label }) => (
      <li><a href={href}>{label}</a></li>
    ))}
    <li><a href="/#contact">Free Case Review</a></li>
  </ul>
  <a href="tel:+12132865834" class="mm-call">Call (213) 286-5834</a>
</div>

<style>
#nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 200;
  height: 110px; background: transparent; border-bottom: 1px solid transparent;
  transition: height .65s cubic-bezier(.16,1,.3,1), background .65s cubic-bezier(.16,1,.3,1), border-color .65s cubic-bezier(.16,1,.3,1);
}
#nav.scrolled {
  height: 62px; background: rgba(255,255,255,0.94);
  backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
  border-bottom: 1px solid rgba(0,0,0,0.055);
}
.nav-inner {
  max-width: 1360px; margin: 0 auto; padding: 0 52px;
  height: 100%; display: flex; align-items: center; justify-content: space-between;
}
.nav-logo { display: flex; align-items: center; text-decoration: none; }
.nav-wordmark {
  font-family: var(--wordmark);
  font-weight: 500;
  font-size: 27px;
  line-height: 1;
  letter-spacing: .005em;
  text-transform: none;
  color: var(--white);
  white-space: nowrap;
  transition: color .55s cubic-bezier(.16,1,.3,1), font-size .65s cubic-bezier(.16,1,.3,1);
}
#nav.scrolled .nav-wordmark { color: var(--black); font-size: 24px; }

.nav-links { display: flex; align-items: center; gap: 32px; list-style: none; opacity: 0; transition: opacity 0.5s cubic-bezier(.16,1,.3,1); }
.nav-links a { font-size: 13.5px; font-weight: 500; color: rgba(255,255,255,.62); text-decoration: none; letter-spacing: -.015em; transition: color .3s; }
.nav-links a:hover, .nav-links a.is-active { color: var(--white); }
#nav.scrolled .nav-links { opacity: 1; }
#nav.scrolled .nav-links a { color: var(--gray-500); }
#nav.scrolled .nav-links a:hover, #nav.scrolled .nav-links a.is-active { color: var(--black); }

.nav-right { display: flex; align-items: center; gap: 18px; }
.nav-phone { font-size: 13.5px; font-weight: 700; color: rgba(255,255,255,.85); text-decoration: none; letter-spacing: -.01em; white-space: nowrap; transition: color .3s; }
.nav-phone:hover { color: var(--white); }
#nav.scrolled .nav-phone { color: var(--black); }

.nav-cta {
  background: var(--gradient); color: var(--black); font-family: var(--sans);
  font-size: 13px; font-weight: 700; padding: 9px 18px; border-radius: 8px; border: none;
  cursor: pointer; letter-spacing: -.02em; text-decoration: none; white-space: nowrap;
  transition: filter .2s, transform .2s cubic-bezier(.2,.8,.2,1);
}
.nav-cta:hover { transform: translateY(-1px); filter: brightness(1.12); }

.nav-burger {
  display: none; flex-direction: column; justify-content: center; gap: 5px;
  width: 40px; height: 40px; padding: 8px; background: none; border: none; cursor: pointer;
}
.nav-burger span {
  display: block; height: 2px; width: 100%; background: var(--white); border-radius: 2px;
  transition: transform .35s cubic-bezier(.16,1,.3,1), opacity .25s, background .3s;
}
#nav.scrolled .nav-burger span, #nav.menu-open .nav-burger span { background: var(--black); }
#nav.menu-open .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
#nav.menu-open .nav-burger span:nth-child(2) { opacity: 0; }
#nav.menu-open .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

.mobile-menu {
  position: fixed; top: 0; left: 0; right: 0; z-index: 190;
  background: rgba(255,255,255,.98); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
  border-bottom: 1px solid var(--gray-200); padding: 90px 24px 28px;
  transform: translateY(-100%); transition: transform .5s cubic-bezier(.16,1,.3,1);
}
.mobile-menu.open { transform: translateY(0); }
.mobile-menu ul { list-style: none; display: flex; flex-direction: column; }
.mobile-menu ul li a {
  display: block; padding: 15px 4px; font-size: 17px; font-weight: 600;
  letter-spacing: -.025em; color: var(--black); text-decoration: none;
  border-bottom: 1px solid var(--gray-100);
}
.mobile-menu .mm-call {
  display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 20px;
  background: var(--gradient); color: var(--white); font-size: 15px; font-weight: 700;
  padding: 15px; border-radius: 10px; text-decoration: none;
}

@media (max-width: 768px) {
  #nav { height: 70px; }
  #nav.scrolled { height: 58px; }
  .nav-inner { padding: 0 20px; }
  .nav-wordmark { font-size: 24px; }
  #nav.scrolled .nav-wordmark { font-size: 21px; }
  .nav-links, .nav-phone, .nav-cta { display: none; }
  .nav-burger { display: flex; }
}
</style>

<script>
(function() {
  const nav = document.getElementById('nav');
  if (!nav) return;
  window.addEventListener('scroll', () => {
    nav.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });
})();

(function() {
  const nav = document.getElementById('nav');
  const burger = document.getElementById('navBurger');
  const menu = document.getElementById('mobileMenu');
  if (!nav || !burger || !menu) return;
  function closeMenu() {
    nav.classList.remove('menu-open');
    menu.classList.remove('open');
    burger.setAttribute('aria-expanded', 'false');
    burger.setAttribute('aria-label', 'Open menu');
  }
  burger.addEventListener('click', () => {
    const open = !menu.classList.contains('open');
    nav.classList.toggle('menu-open', open);
    menu.classList.toggle('open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  menu.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
})();
</script>
